PORT=3000
APP_URL=http://localhost:3000

# PostgreSQL from docker compose
DATABASE_URL=postgresql://notes:notes@localhost:5434/notes

# At least 32 bytes. Generate with: openssl rand -base64 32
JWT_SECRET=

# Test admin account, created by `npm run db:seed`. Admins sign in with email and password only.
ADMIN_EMAIL=admin@notes.test
ADMIN_PASSWORD=Admin-Test-Pass-2026

# Google: OAuth client of type "Web application",
# redirect URI http://localhost:3000/auth/oidc/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra ID: app registration in your tenant,
# redirect URI http://localhost:3000/auth/oidc/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Mailpit from docker compose: read the emails at http://localhost:8026
SMTP_URL=smtp://localhost:1026
MAIL_FROM="Notes <no-reply@example.com>"
